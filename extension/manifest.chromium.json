{
  "manifest_version": 3,
  "name": "HyprView tabs",
  "version": "1.3.0",
  "description": "Reports open tabs to the HyprView compositor plugin.",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "activeTab"
  ],
  "optional_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
