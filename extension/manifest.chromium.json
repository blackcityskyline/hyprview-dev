{
  "manifest_version": 3,
  "name": "GloView tabs",
  "version": "0.1.0",
  "description": "Reports open tabs to the GloView compositor plugin.",
  "permissions": ["tabs", "favicon", "activeTab"],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  }
}